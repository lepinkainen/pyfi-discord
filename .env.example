# Required: dedicated development bot and test guild, never production credentials.
DISCORD_KEY=
CLIENT_ID=
GUILD_ID=

# Optional: pyfibot Lambda backend.
# LAMBDA_URL=
# LAMBDA_APIKEY=

# Optional: proactive replies (may incur API charges).
# ANTHROPIC_API_KEY=
# PROACTIVE_CHANNELS=channel-id,another-channel-id
# PROACTIVE_MODEL=claude-sonnet-4-6
# PROACTIVE_COOLDOWN_MS=30000
# PROACTIVE_DEBUG=1
# PROACTIVE_WEB_SEARCH=1

# Optional: RAG defaults are data/rag.db and data/datasets.json.
# RAG_DB_PATH=data/rag.db
# RAG_DATASETS_PATH=data/datasets.json
